# Supabase project "nextlap" (Project Settings → API).
# Read-only access: the publishable key is enough because RLS only allows SELECT.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Car-data files for the replay (public Storage bucket "telemetry"). Leave empty in development to
# read public/telemetry. The URL is public by design; never put a secret key in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_TELEMETRY_URL=https://<project-ref>.supabase.co/storage/v1/object/public/telemetry
NEXT_PUBLIC_TELEMETRY_URL=

# Deployed model API (inference/ on Railway). Optional: when set, the final LSTM forecasts of a race
# are read from it; when empty, slow or unreachable the stored predictions in Supabase are used.
INFERENCE_API_URL=
